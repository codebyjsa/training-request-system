<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/training_letter/db" VERSION="20261031" COMMENT="XMLDB file for Training Request Letter Generator">
    <TABLES>
        <TABLE NAME="local_training_letter" COMMENT="Training letter requests">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="studentname" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT=""/>
                <FIELD NAME="rollnumber" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT=""/>
                <FIELD NAME="branch" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT=""/>
                <FIELD NAME="semester" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="companyname" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT=""/>
                <FIELD NAME="companyaddress" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="phone" TYPE="char" LENGTH="20" NOTNULL="false" DEFAULT=""/>
                <FIELD NAME="trainingtype" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="software"/>
                <FIELD NAME="duration" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="6 Weeks"/>
                <FIELD NAME="startdate" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="enddate" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="description" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending"/>
                <FIELD NAME="rejectionreason" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="coordinatorremarks" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="reviewedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="userid_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="status_idx" UNIQUE="false" FIELDS="status"/>
                <INDEX NAME="rollnumber_idx" UNIQUE="false" FIELDS="rollnumber"/>
                <INDEX NAME="trainingtype_idx" UNIQUE="false" FIELDS="trainingtype"/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>
